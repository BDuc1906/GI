
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---- Nhân vật (Characters) ----
model Character {
  id          String   @id            // slug, vd: "kazuha"
  name        String
  title       String?
  vision      String                  // nguyên tố: Anemo, Pyro, ...
  weaponType  String                  // Sword, Claymore, Polearm, Bow, Catalyst
  rarity      Int                     // 4 hoặc 5 sao
  region      String?
  affiliation String?
  // releaseDate: genshin-db KHÔNG cung cấp ngày ra mắt thật ngoài đời
  // (đây là ngày trong game/banner, không có sẵn trong package này).
  // Giữ field lại nhưng để null cho tới khi có nguồn dữ liệu khác
  // (vd HoYoLAB changelog hoặc fandom wiki scrape riêng).
  releaseDate DateTime?
  description String?  @db.Text
  // ---- Ảnh HIỂN THỊ (dùng trong toàn bộ UI) ----
  // Sở hữu: scripts/mirror-images-to-r2.ts SAU LẦN MIRROR ĐẦU TIÊN. Trước
  // đó (nhân vật vừa seed, chưa mirror lần nào) do scripts/seed-characters.ts
  // set tạm bằng hotlink lúc create. scripts/seed-characters.ts KHÔNG BAO
  // GIỜ được ghi đè các cột này ở nhánh update — xem comment ở cột
  // *Original bên dưới để hiểu lý do tách 2 nhóm cột.
  iconUrl     String?
  sideIconUrl String?
  splashUrl   String?
  elementIcon    String?
  // ---- Ảnh GỐC (hotlink enka.network/mihoyo tại lần crawl gần nhất) ----
  // Sở hữu: scripts/seed-characters.ts — ghi đè TỰ DO mỗi lần
  // `npm run data:crawl && npm run db:seed` chạy (kể cả chạy tự động hàng
  // tuần qua .github/workflows/update-data.yml), vì đây chỉ là bản ghi
  // "nguồn dữ liệu gốc nói gì", không phải ảnh thật sự đang hiển thị.
  //
  // Lý do bắt buộc phải tách khỏi cột hiển thị ở trên: trước khi có 2 cột
  // này, seed-characters.ts và mirror-images-to-r2.ts cùng ghi vào 1 cột
  // (iconUrl/sideIconUrl/splashUrl) — mỗi lần seed tự động chạy lại sẽ ghi
  // đè URL đã mirror sang R2 bằng hotlink gốc, khiến toàn bộ công mirror
  // trước đó bị hoàn tác âm thầm (không lỗi, không log, ảnh chỉ đơn giản
  // quay lại hotlink rồi có thể chết theo API nguồn). scripts/mirror-images-to-r2.ts
  // đọc nguồn tải từ các cột *Original này, KHÔNG đọc từ cột hiển thị.
  //
  // src/components/SafeImage.tsx cũng dùng các cột này làm URL dự phòng
  // cuối cùng khi ảnh trên R2 lỗi (qua prop `fallbackSrcs`) — đây là URL
  // gốc THẬT (không phải suy đoán từ tên file trên R2, vì tên object trên
  // R2 là tên generic do mirror script đặt, không giữ tên file gốc).
  iconUrlOriginal     String?
  sideIconUrlOriginal String?
  splashUrlOriginal   String?
  elementIconOriginal String?
  baseHp      Float?
  baseAtk     Float?
  baseDef     Float?
  ascensionStat String?
  // Nguyên liệu đột phá 6 giai đoạn:
  // [{ phase, materials: [{ materialId, name, count }] }]
  // materialId trỏ tới Material.id — join lúc render để lấy iconUrl,
  // "name" giữ lại làm fallback hiển thị nếu Material chưa/không seed được.
  ascensionMaterials Json?
  // Chỉ số HP/ATK/DEF/chỉ số phụ ở các mốc cấp + trước/sau đột phá:
  // [{ level, ascension, hp, attack, defense, specialized }]
  talentMaterials Json?
  statsByLevel Json?
  birthday    String?                 // vd "October 29"
  // Tên "chòm sao bản mệnh" (flavor, khác 6 cung mệnh kỹ năng bên dưới), vd "Acer Palmatum"
  constellationName String?
  voiceActors Json?                   // { english, chinese, japanese, korean }
  gameVersion String?                 // phiên bản game nhân vật ra mắt, vd "1.6"
  wikiUrl     String?
  constellations Json?                // [{ level, name, description }] x6 — cung mệnh kỹ năng
  talents        Json?                // [{ key, name, description }] — đòn thường/kỹ năng/trọng kích/passive
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([vision])
  @@index([weaponType])
  @@index([rarity])
}

// ---- Nguyên liệu (dùng chung: đột phá nhân vật, sau này cả cường hóa vũ khí) ----
// Tách bảng riêng thay vì nhét iconUrl vào JSON của từng Character để tránh
// lặp lại URL ảnh (hàng trăm nhân vật dùng chung một số loại nguyên liệu).
// Character.ascensionMaterials chỉ lưu { materialId, name, count } — icon
// join từ đây lúc render.
model Material {
  id        String   @id // slug tên nguyên liệu, vd "vayuda-turquoise-sliver"
  name      String   @unique
  // Ảnh hiển thị — sở hữu bởi mirror-images-to-r2.ts sau lần mirror đầu.
  iconUrl   String?
  // Ảnh gốc (hotlink) — sở hữu bởi seed-helpers.ts::upsertMaterial, ghi đè
  // tự do mỗi lần seed. Xem comment chi tiết ở Character.iconUrlOriginal.
  iconUrlOriginal String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---- Vũ khí (Weapons) ----
model Weapon {
  id          String   @id
  name        String
  type        String
  rarity      Int
  baseAtk     Float?
  statsByLevel Json?
  subStatName String?
  subStatValue String?
  effectName  String?
  // Toàn bộ 5 mốc tinh luyện: [{ description }, ...] — đây là nguồn hiển thị
  // duy nhất trên trang chi tiết vũ khí (đã bỏ effectDescriptionR1/R5 vì
  // trùng lặp dữ liệu và không được UI dùng tới).
  passiveByRefinement Json?
  description String?  @db.Text
  // Ảnh hiển thị — sở hữu bởi mirror-images-to-r2.ts sau lần mirror đầu.
  iconUrl     String?
  // Ảnh gốc (hotlink) — sở hữu bởi seed-weapons.ts, ghi đè tự do mỗi lần
  // seed. Xem comment chi tiết ở Character.iconUrlOriginal.
  iconUrlOriginal String?
  ascensionMaterials Json?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([rarity])
}

// ---- Thánh di vật (Artifact Sets) ----
model ArtifactSet {
  id          String   @id
  name        String
  rarityRange Int[]
  // Trước đây thiếu field 1pc riêng -> code cũ nhét nhầm effect1Pc
  // vào fourPieceBonus cho các set cũ chỉ có 1pc+2pc (Berserker, Instructor...).
  onePieceBonus  String? @db.Text
  twoPieceBonus  String? @db.Text
  fourPieceBonus String? @db.Text
  pieces      Json?
  // Ảnh hiển thị — sở hữu bởi mirror-images-to-r2.ts sau lần mirror đầu.
  iconUrl     String?
  // Ảnh gốc (hotlink) — sở hữu bởi seed-artifacts.ts, ghi đè tự do mỗi lần
  // seed. Xem comment chi tiết ở Character.iconUrlOriginal. (Riêng các ảnh
  // trong `pieces` JSON không bị mirror nên không cần cột Original tương ứng.)
  iconUrlOriginal String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([rarityRange])
}

// ---- Bí cảnh (Domains) ----
// Nguồn: genshin-db `domains` folder. Data gốc có 256 entry vì mỗi bí cảnh
// tách riêng theo độ khó (I/II/III/IV/V) — gộp lại còn ~65 bí cảnh gốc lúc
// seed (xem scripts/seed-domains.ts), vì độ khó chỉ đổi số lượng phần
// thưởng, không đổi lịch mở/nguyên liệu/quái — hiển thị 4-5 dòng gần như
// giống hệt nhau không có giá trị cho người tra "hôm nay đánh gì".
model Domain {
  id          String   @id // slug từ tên gốc (đã bỏ số La Mã độ khó)
  name        String
  // "artifact" (Domain of Blessing, mở hằng ngày) | "weapon" (Domain of
  // Forgery) | "talent" (Domain of Mastery) — 2 loại sau chỉ mở 3 ngày/tuần
  // luân phiên, xem daysOfWeek.
  category    String
  regionName  String?
  description String?  @db.Text
  recommendedLevel    Int?
  recommendedElements String[]
  // Rỗng = mở hằng ngày (domain thánh di vật). Có giá trị = chỉ mở đúng các
  // ngày này trong tuần (domain vũ khí/sách thiên phú).
  daysOfWeek  String[]
  unlockRank  Int?
  // Nguyên liệu đặc trưng domain này rớt (không gồm Mora/EXP/Companionship
  // EXP — mấy cái đó domain nào cũng có, không giúp phân biệt):
  // [{ materialId, name }] — materialId trỏ tới Material.id, join lúc render.
  materials   Json?
  // Tên quái xuất hiện trong bí cảnh — chưa map sang bảng riêng, để plain
  // text; sẽ nối vào bảng Enemy khi làm giai đoạn "Enemies/Bosses".
  monsterNames String[]
  // Ảnh hiển thị — sở hữu bởi mirror-images-to-r2.ts sau lần mirror đầu.
  imageUrl    String?
  // Ảnh gốc (hotlink) — sở hữu bởi seed-domains.ts, ghi đè tự do mỗi lần
  // seed. Xem comment chi tiết ở Character.iconUrlOriginal.
  imageUrlOriginal String?
  gameVersion String?  // phiên bản game domain này xuất hiện, vd "4.0"
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([category])
}
// ---- Pipeline Run (giám sát tự động) ----
model PipelineRun {
  id          String   @id @default(cuid())
  name        String   // "crawl", "seed", "mirror", "update-data"
  status      String   // "started", "success", "failed"
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  durationMs  Int?
  error       String?  @db.Text
  details     Json?    // metadata: rows affected, images mirrored, etc.
  createdAt   DateTime @default(now())

  @@index([name])
  @@index([status])
  @@index([startedAt(sort: Desc)])
}

// ---- AI Agent: bộ nhớ hội thoại ----
// Lưu lịch sử chat theo session để agent nhớ ngữ cảnh giữa các lượt hỏi.
// Sở hữu & đọc/ghi: src/agent/utils/db-memory.ts (class DbMemory).
// `id` do tầng ứng dụng cấp (sessionId từ client), KHÔNG dùng @default —
// giống quy ước Character/Weapon/Domain ở trên (id là khoá nghiệp vụ,
// không phải khoá surrogate tự sinh).
model AgentSession {
  id        String   @id
  userId    String?
  // Toàn bộ lịch sử hội thoại: ChatMessage[] (xem src/agent/core/schemas.ts).
  // Mặc định "[]" khớp giá trị khởi tạo DbMemory.getOrCreateSession truyền vào.
  messages  Json     @default("[]")
  metadata  Json     @default("{}")
  // Không @default ở DB — DbMemory luôn set thủ công lúc update, còn lúc
  // create Prisma tự điền timestamp hiện tại nhờ @updatedAt (đúng hành vi
  // đã có từ migration gốc: cột NOT NULL nhưng không có DB-level default).
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([updatedAt(sort: Desc)])
}

// ---- AI Agent: nhật ký kiểm toán (audit log) ----
// Ghi lại MỌI lần agent (hoặc AutoFixEngine) thay đổi dữ liệu — bắt buộc
// phải tồn tại trước khi bật tool "fix"/"sync" cho môi trường thật, vì đây
// là cách duy nhất truy vết "ai/khi nào/sửa gì" khi có sự cố dữ liệu sai.
// Sở hữu & đọc/ghi: src/lib/agent/AuditLogger.ts.
// `id` dùng @default(cuid()) vì AuditLogger.createAuditLog() không truyền
// id — khác AgentSession ở trên (đối chiếu kỹ trước khi sửa lại field này).
model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  oldValue    Json?
  newValue    Json?
  performedBy String
  sessionId   String?
  reason      String?  @db.Text
  status      String   @default("success")
  error       String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([createdAt(sort: Desc)])
}
