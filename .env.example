DATABASE_URL=

DIRECT_URL=

# URL public của site khi deploy — dùng để sinh sitemap.xml/robots.txt đúng domain.
# Bỏ trống hoặc để mặc định khi chạy local (fallback http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=leibo-images
R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=
# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=leibo
SENTRY_PROJECT=javascript-nextjs
SENTRY_AUTH_TOKEN=
# ---- AI Agent ----
AGENT_LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=4096
AGENT_MAX_STEPS=5
AGENT_TIMEOUT=30000
AGENT_DEBUG=false
AGENT_USE_DB=true
AGENT_MAX_MESSAGES=20

# ---- Admin ----
ADMIN_API_KEY=YOUR_RANDOM_SECRET_KEY_HERE

# ---- Rate limit riêng cho /api/agent ----
AGENT_RATE_LIMIT=10
AGENT_RATE_LIMIT_WINDOW=60 s

# ---- Sync qua GitHub Actions (bỏ trống nếu chưa dùng nút "Đồng bộ dữ liệu") ----
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_DEFAULT_BRANCH=main

# ---- Điều tiết AutoFixEngine ----
AGENT_FIX_CONCURRENCY=5
AGENT_FIX_BATCH_DELAY_MS=300

# ---- Live data provider (bỏ trống nếu chưa test Ambr) ----
AGENT_LIVE_PROVIDER=ambr
AMBR_API_BASE_URL=https://api.ambr.top/v2/en
