@import "tailwindcss";

:root {
  --ink: #12141c;
  --ink-raised: #1a1d29;
  --gold: #C9A66B;
  --gold-bright: #F4D03F;
  --parchment: #EDE6D6;
  --parchment-dim: #9a9484;
  --purple-glow: #B57EDC;

  --el-anemo: #6FC6A3;
  --el-geo: #CFA83E;
  --el-electro: #B98FE0;
  --el-dendro: #A2C93B;
  --el-hydro: #4CC2F1;
