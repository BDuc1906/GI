    await seedArtifacts();
    console.log("=== ALL DATA SEEDED SUCCESSFULLY ===");
  } catch (error) {
    console.error("❌ Seeding halted due to critical error:");
    console.error(error);
    process.exit(1);
  }
}

main()
  .catch((e) => {
    console.error(e);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
</file>

