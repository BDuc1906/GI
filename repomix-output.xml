  --gold-bright: #c9a03a;
  --shadow-glow: 0 0 20px rgba(184, 148, 74, 0.10);
  --shadow-card: 0 4px 12px rgba(0,0,0,0.06);
}

* {
  transition: background-color 0.25s ease, color 0.2s ease, border-color 0.25s ease;
}

body {
  background: var(--bg-primary);
  color: var(--text-primary);
  font-family: 'Inter', sans-serif;
  line-height: 1.6;
}

.font-display {
  font-family: 'Cinzel', serif;
}

/* ===== Các lớp dùng chung ===== */
.relic-frame {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 1rem;
  box-shadow: var(--shadow-card);
  transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
}
.relic-frame:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-glow), var(--shadow-card);
  border-color: var(--gold);
}

/* Rarity glow */
.rarity-glow-5 {
  border-color: rgba(244, 208, 63, 0.45);
}
[data-theme="light"] .rarity-glow-5 {
  border-color: #b8944a;
  box-shadow: 0 0 12px rgba(184, 148, 74, 0.15);
}

.rarity-glow-4 {
  border-color: rgba(181, 126, 220, 0.4);
}
[data-theme="light"] .rarity-glow-4 {
  border-color: #9a6bb8;
  box-shadow: 0 0 12px rgba(154, 107, 184, 0.15);
}

.rarity-glow-3 {
  border-color: rgba(201, 166, 107, 0.25);
}
[data-theme="light"] .rarity-glow-3 {
  border-color: #b8944a;
  box-shadow: 0 0 12px rgba(184, 148, 74, 0.10);
}

/* Input & Button */
input, button {
  background: var(--bg-input);
  border-color: var(--border-color);
  color: var(--text-primary);
}
input::placeholder {
  color: var(--text-muted);
}
button:hover {
  border-color: var(--gold);
}

/* Divider */
.divider-gold {
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
}

/* Links */
a {
  color: var(--text-primary);
  transition: color 0.2s;
}
a:hover {
  color: var(--gold-bright);
}

/* Table */
table {
  border-collapse: collapse;
  width: 100%;
}
th, td {
  border-color: var(--border-color);
  padding: 0.75rem 1rem;
  text-align: left;
}
th {
  background: var(--bg-table);
  color: var(--text-secondary);
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.75rem;
  letter-spacing: 0.05em;
}
tr {
  border-bottom: 1px solid var(--border-color);
}
tr:nth-child(even) {
  background: var(--bg-table-alt);
}

/* Utility classes */
.bg-primary { background-color: var(--bg-primary); }
.bg-secondary { background-color: var(--bg-secondary); }
.bg-card { background-color: var(--bg-card); }
.bg-table { background-color: var(--bg-table); }
.bg-table-alt { background-color: var(--bg-table-alt); }
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-muted { color: var(--text-muted); }
.text-inverted { color: var(--text-inverted); }
.border-border { border-color: var(--border-color); }
.shadow-card { box-shadow: var(--shadow-card); }
</file>

<file path="src/lib/prisma.ts">
import { PrismaClient } from "@prisma/client";
import { PrismaPg } from "@prisma/adapter-pg";
import { assertEnv } from "./env";

assertEnv();

const globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };

const adapter = new PrismaPg({
  connectionString: process.env.DATABASE_URL,
  // Neon (như hầu hết managed Postgres) luôn dùng chứng chỉ SSL hợp lệ, kể cả
  // qua pooler — không có tình huống self-signed cần tắt verify ở dev như
  // một số nhà cung cấp khác, nên bật rejectUnauthorized ở mọi môi trường.
  ssl: { rejectUnauthorized: true },
});

export const prisma =
  globalForPrisma.prisma ?? new PrismaClient({ adapter });

if (process.env.NODE_ENV !== "production") globalForPrisma.prisma = prisma;
</file>

<file path="src/lib/theme.ts">
// Định nghĩa mã màu phát sáng cho các Nguyên tố trong Genshin Impact
export const ELEMENT_COLORS: Record<string, string> = {
  Anemo: "#6FC6A3",
  Geo: "#CFA83E",
  Electro: "#B98FE0",
  Dendro: "#A2C93B",
  Hydro: "#4CC2F1",
  Pyro: "#EF7938",
  Cryo: "#8FE0E0",
};

export function elementColor(vision: string): string {
  return ELEMENT_COLORS[vision] || "#999999";
}

export function rarityStars(rarity: number): string {
  return "★".repeat(rarity);
}

// Sử dụng class từ globals.css – tự động thích ứng dark/light
export function rarityGlowClass(rarity: number): string {
  switch (rarity) {
    case 5: return "rarity-glow-5";
    case 4: return "rarity-glow-4";
    default: return "rarity-glow-3";
  }
}

export function rarityTextClass(rarity: number): string {
  switch (rarity) {
    case 5: return "text-amber-400 font-bold";
    case 4: return "text-purple-400 font-bold";
    default: return "text-blue-400 font-bold";
  }
}
</file>

