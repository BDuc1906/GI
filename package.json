{
  "name": "leibo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync/sync-docs.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/sync/sync-docs.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:legacy": "tsc6 --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node scripts/maintenance/clean.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file=.env scripts/seed/seed.ts",
    "db:seed:full": "npm run db:seed && npm run images:mirror",
    "data:crawl": "tsx scripts/pipeline/crawl-characters.ts && tsx scripts/pipeline/crawl-extra-data.ts",
    "db:verify": "tsx --env-file=.env scripts/seed/verify-seed-integrity.ts",
    "data:fix-vision": "tsx --env-file=.env scripts/fix/fix-vision-mismatch.ts",
    "images:mirror": "tsx --env-file=.env scripts/images/mirror-images-to-r2.ts",
    "data:update": "tsx scripts/sync/update-data.ts",
    "db:full": "npm run data:update && npm run data:crawl && npm run db:seed && npm run images:mirror"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.113",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.69.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "ai": "^6.0.266",
    "dotenv": "^17.4.2",
    "next": "^16.3.3",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "pg": "^8.13.1",
    "postcss": "^8.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@eslint/eslintrc": "^3.2.0",
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "genshin-db": "^5.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react-hooks": {
      "eslint": "$eslint"
    }
  }
}
