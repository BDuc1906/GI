{
  "name": "leibo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-docs.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/sync-docs.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node scripts/clean.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "data:crawl": "tsx scripts/pipeline/crawl-characters.ts",
    "db:verify": "tsx --env-file=.env scripts/verify-seed-integrity.ts",
    "images:mirror": "tsx --env-file=.env scripts/mirror-images-to-r2.ts",
    "data:update": "tsx scripts/update-data.ts",
    "db:full": "npm run data:update && npm run data:crawl && npm run db:seed && npm run images:mirror"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.69.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "dotenv": "^17.4.2",
    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "pg": "^8.13.1",
    "postcss": "^8.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@eslint/eslintrc": "^3.2.0",
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "genshin-db": "^5.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
